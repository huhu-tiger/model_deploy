# UFW 默认配置（Makefile 与 ufw.sh 共用，修改此处即可）

# 默认开放端口（make enable，仅 SSH；服务端口请用主机预设 h20-43 / A800-40）
#   22                 SSH
UFW_DEFAULT_TARGET_PORTS="22"

# 白名单 IP/CIDR/通配符（空格分隔）
#   211.99.216.18      北京公网固定 IP（运维出口）
#   211.151.86.30      北京公网固定 IP / 公网无线 Resident
#   120.133.137.*      MinIO / 对象存储网段（如 120.133.137.142）
#   192.168.*.*        内网 RFC1918
#   172.16.0.0/12      内网 RFC1918：Docker 网桥（172.17.x 等）+ H20 bond0 管理网（172.31.0.43/44，代理 172.31.0.55）
#   59.151.19.*        广州公网网段 (172.22.221.212 172.22.221.214 10.20.201.215 172.16.130.221)
#   61.49.53.*         模型评测 / API 调用机（如 61.49.53.41、.42）
UFW_DEFAULT_WHITELIST="211.99.216.18 211.151.86.30 120.133.137.* 192.168.*.* 172.16.0.0/12 59.151.19.* 61.49.53.*"

# bjdb-h20-node-043 预设（make h20-43）
#   22                 SSH
#   30001              LLM OpenAI 兼容 API（vLLM / MiniMax-M3-AWQ 等）
#   30002              第二路 LLM API（GLM INT8、llama.cpp 等）
UFW_H20_43_PORTS="22 30001 30002"
#   10.212.0.0/16      在默认白名单基础上追加：h20 VPN 内网 SSH 跳板 / 堡垒机网段（如 10.212.134.105）
UFW_H20_43_WHITELIST="${UFW_DEFAULT_WHITELIST} 10.212.0.0/16"

# bjdb-h100-04 / H100-42 预设（make H100-42）
#   22                 SSH
#   30001              LLM OpenAI 兼容 API（vLLM / GLM-5.2 等）
UFW_H100_42_PORTS="22 30001"
UFW_H100_42_WHITELIST="${UFW_DEFAULT_WHITELIST}"

# bjdb-A800-40 预设（make A800-40）
#   端口：/home/taojun/ufw.sh（含 9116 VL API）
#   白名单：UFW_DEFAULT_WHITELIST ∪ /home/taojun/ufw.sh 独有条目
UFW_A800_40_PORTS="22 9131 9116 10010:10034"
#   182.92.123.191     /home/taojun/ufw.sh 公网 IP
#   120.244.*.*        /home/taojun/ufw.sh 公网网段
#   202.108.99.157     /home/taojun/ufw.sh 公网 IP
#   183.*.*.*          /home/taojun/ufw.sh 公网网段
#   124.250.117.6      /home/taojun/ufw.sh 公网 IP
#   （211.99.216.18、120.133.137.178、59.151.19.26、192.168.0.2/3 已由默认白名单覆盖）
UFW_A800_40_WHITELIST="${UFW_DEFAULT_WHITELIST} 182.92.123.191 120.244.*.* 202.108.99.157 183.*.*.* 124.250.117.6"
