# UFW 默认配置（Makefile 与 ufw.sh 共用，修改此处即可）

# 默认开放端口（make enable，仅 SSH；服务端口请用主机预设 h20-43 / h20-44 / h100-42 / a800-40 / a800-43）
#   22                 SSH
UFW_DEFAULT_TARGET_PORTS="22"

# 白名单 IP/CIDR/通配符（空格分隔）
#   211.99.216.18      北京公网固定 IP（运维出口）
#   211.151.86.30      北京公网固定 IP / 公网无线 Resident
#   120.133.137.*      MinIO / 对象存储网段（如 120.133.137.142）
#   192.168.*.*        内网 RFC1918
#   172.16.0.0/12      内网 RFC1918：Docker 网桥（172.17.x 等）+ H20 bond0 管理网（172.31.0.43/44，代理 172.31.0.55）
#   59.151.19.0/25     互联VPN 以及 出网   59.151.19.114-116 (172.22.221.212 172.22.221.214 10.20.201.215 172.16.130.221)
#   61.49.53.*         模型评测 / API 调用机（如 61.49.53.41、.42）
#   10.212.0.0/16      H20 VPN内网IP（如 10.212.134.105）
UFW_DEFAULT_WHITELIST="211.99.216.18 211.151.86.30 120.133.137.* 192.168.*.* 172.16.0.0/12 59.151.19.0/25 61.49.53.* 10.212.0.0/16"

# bjdb-h20-node-043 预设（make h20-43 或 H20-43）
#   22                 SSH
#   30001              LLM OpenAI 兼容 API（vLLM / MiniMax-M3-AWQ 等）
#   30002              第二路 LLM API（GLM INT8、llama.cpp 等）
#   2000:10000         通用 TCP 服务端口段
#   20000              SGLang 双节点 dist-init / 集群通信（worker，供 node-44 master 回连）
UFW_H20_43_PORTS="22 30001 30002 2000:10000 20000"
UFW_H20_43_WHITELIST="${UFW_DEFAULT_WHITELIST}"

# bjdb-h20-node-044 预设（make h20-44 或 H20-44）
#   22                 SSH
#   58083              LLM OpenAI 兼容 API（DeepSeek-v3.2 nginx 等；>10000，须单独列出）
#   2000:10000         通用 TCP 服务端口段
#   20000              SGLang 双节点 dist-init（master，供 node-43 worker 接入）
#   （30001 MiniMax-M3-IB nginx 未部署时勿开放）
UFW_H20_44_PORTS="22 58083 2000:10000 20000"
UFW_H20_44_WHITELIST="${UFW_DEFAULT_WHITELIST}"

# bjdb-h100-04 / H100-42 预设（make h100-42 或 H100-42）
#   22                 SSH
#   30001              LLM OpenAI 兼容 API（vLLM / GLM-5.2 等）
UFW_H100_42_PORTS="22 30001"
UFW_H100_42_WHITELIST="${UFW_DEFAULT_WHITELIST}"

# bjdb-A800-40 预设（make a800-40 或 A800-40）
#   端口：/home/taojun/ufw.sh（含 9116 VL API）
#   白名单：UFW_DEFAULT_WHITELIST ∪ /home/taojun/ufw.sh 独有条目
UFW_A800_40_PORTS="22 9131 9116 9410 10010:10034"
#   182.92.123.191     /home/taojun/ufw.sh 公网 IP
#   183.*.*.*          家庭宽带
#   （211.99.216.18、120.133.137.178、59.151.19.26、192.168.0.2/3 已由默认白名单覆盖）
UFW_A800_40_WHITELIST="${UFW_DEFAULT_WHITELIST} 183.*.*.*"

# bjdb-A800-43 预设（make a800-43 或 A800-43）
#   22                 SSH
#   8080               PaddleX OCR（paddlex）
#   9111               Qwen-Image-2512 文生图（vllm-qwen-image-2512）
#   9116               Qwen3-VL-32B 多模态 API（vllm-qwen3-vl-32B）
#   20170:20172        v2raya 代理
#   27171              v2raya Web UI
#   30008              PaddleOCR-VL-1.6 API（paddleocr-vl-1.6-api）
#   30009              PaddleOCR-VL-1.6 VLM Server（paddleocr-vl-1.6-vlm-server）
UFW_A800_43_PORTS="22 8000 8080 9111 9116 20170:20172 27171 30008 30009"
UFW_A800_43_WHITELIST="${UFW_DEFAULT_WHITELIST}"
