# 集群节点配置（复制为 cluster.env: make init）
# 主机名不在此配置：写 /etc/hosts 与 compose 时由 hostname 命令自动获取
# 必须在 master 机器上执行 make restart / ./run.sh
# 本仓库默认拓扑：master=172.31.0.43（本机） worker=172.31.0.44

# master（本机，运行 make / ./run.sh 的机器，rank 0，对外 API）
MASTER_IP=

# worker（远程 rank 1，纯计算节点）
WORKER_IP=

# SGLang torch.distributed rendezvous 端口（两台节点必须可互通）
MASTER_DIST_PORT=20000

# SSH / 远程部署路径（worker 上 /tmp 子目录）
REMOTE_USER=root
REMOTE_DEPLOY_DIR=/tmp/deepseek-v4-flash-IB/node-44

# 可选：等待 dist-init 就绪（秒）
# MASTER_DIST_WAIT_SEC=900
# SERVICE_READY_WAIT_SEC=1800

# 可选：模型、JIT 缓存与镜像
# MODEL_HOST_PATH=/media/llm/deepseek-ai/DeepSeek-V4-Flash-0731
# CACHE_HOST_PATH=/media/llm/deepseek-v4-flash-0731-cache
# DOCKER_IMAGE=model.vnet.com/sjhl/sglang:v0.5.18
