# DeepSeek-V4-Flash 双节点集群配置（make / ./run.sh 自动加载）
# 必须在 master（本机 172.31.0.43）上执行 make restart
# 主机名不在此配置：./run.sh hosts 时由本机 hostname 与 ssh worker hostname 获取

# ── master（本机 node-43，运行 make / ./run 的机器，rank 0）──
MASTER_IP=172.31.0.43

# ── worker（远程 node-44，rank 1，纯计算节点）──
WORKER_IP=172.31.0.44

# ── SGLang rendezvous（compose: --dist-init-addr ${MASTER_IP}:${MASTER_DIST_PORT}）──
MASTER_DIST_PORT=20000

# ── SSH 与远程部署目录（worker_sync 复制 compose + cluster.env）──
REMOTE_USER=root
REMOTE_DEPLOY_DIR=/tmp/deepseek-v4-flash-IB/node-44

# ── 可选 ──
# MASTER_DIST_WAIT_SEC=900
MODEL_HOST_PATH=/media/llm/deepseek-ai/DeepSeek-V4-Flash-0731
DOCKER_IMAGE=model.vnet.com/sjhl/sglang:v0.5.17
