# 集群节点配置（复制为 cluster.env: make init）
# 主机名不在此配置：写 /etc/hosts 与 compose 时由 hostname 命令自动获取

# master（本机，运行 make / ./run 的机器）
MASTER_IP=

# worker（远程 rank 1）
WORKER_IP=

# 分布式 rendezvous（通常 = MASTER_IP:端口）
MASTER_DIST_PORT=20000

# SSH / 远程部署路径（worker 上 /tmp 子目录）
REMOTE_USER=root
REMOTE_DEPLOY_DIR=/tmp/minimax-m3-IB/node-43

# 可选：等待 dist-init 就绪（秒）
# MASTER_DIST_WAIT_SEC=900

# 可选：模型与镜像
# MODEL_HOST_PATH=/media/llm/MiniMax/MiniMax-M3
# DOCKER_IMAGE=model.vnet.com/sjhl/sglang:dev-minimax-m3
