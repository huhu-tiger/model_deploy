# MiniMax-M3 双节点集群配置（make / ./run 自动加载，纳入 git 同步到远程仓库）
# 复制模板: make init（见 cluster.env.example）
# 主机名不在此配置：./run hosts 时由本机 hostname 与 ssh worker hostname 获取

# ── master（本机 node-44，运行 make / ./run 的机器，rank 0）──
MASTER_IP=172.31.0.44

# ── worker（远程 node-43，rank 1，纯计算节点）──
WORKER_IP=172.31.0.43

# ── 分布式 rendezvous 端口（compose: --dist-init-addr ${MASTER_IP}:${MASTER_DIST_PORT}）──
MASTER_DIST_PORT=20000

# ── SSH 与远程部署目录（worker 上 /tmp 子目录，worker_sync 复制 compose + cluster.env）──
REMOTE_USER=root
REMOTE_DEPLOY_DIR=/tmp/minimax-m3-IB/node-43

# ── 可选 ──
# MASTER_DIST_WAIT_SEC=900          # 等待 master dist-init 端口就绪（秒，默认 900）
# MODEL_HOST_PATH=/media/llm/MiniMax/MiniMax-M3
# DOCKER_IMAGE=model.vnet.com/sjhl/sglang:dev-minimax-m3
