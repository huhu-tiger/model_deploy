# MiniMax-M3-AWQ-INT4 — 官方 README 流程（uv + VLLM_USE_PRECOMPILED）
# ModelScope: https://modelscope.cn/models/cyankiwi/MiniMax-M3-AWQ-INT4
# 参考: https://huggingface.co/cyankiwi/MiniMax-M3-AWQ-INT4
#
# 基础镜像: nvidia/cuda:devel（与 vLLM 官方 Dockerfile 一致）
# 安装: uv → clone toncao → fetch upstream a7fdfeef → uv pip install -e .
#
# 构建:
#   make build-precompiled
# 内网 CUDA 基础镜像:
#   make build-precompiled CUDA_BASE=内网/nvidia/cuda:13.0.2-devel-ubuntu22.04
#
# 注意: 预编译 wheel 可能不含 M3 CUDA 算子（此前方案 C 已验证失败）；
#       若构建验证失败，请改用 make build（方案 B 源码编译）或 make build-a。

ARG BASE_IMAGE=model.vnet.com/sjhl/cuda:13.0.2-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ARG UPSTREAM_COMMIT=a7fdfeef72323eb3db6f0620e4ea200290d0ca5a
ARG PATCH_COMMIT=8f1350ebf25f188a77022c70b575731f0df6a61a
ARG UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG MAX_JOBS=64
ARG NVCC_THREADS=4

ENV DEBIAN_FRONTEND=noninteractive \
    UV_INDEX_URL=${UV_INDEX_URL} \
    UV_EXTRA_INDEX_URL=${UV_EXTRA_INDEX_URL} \
    UV_INDEX_STRATEGY=unsafe-best-match \
    VLLM_USE_PRECOMPILED=1 \
    MAX_JOBS=${MAX_JOBS} \
    NVCC_THREADS=${NVCC_THREADS} \
    PATH="/root/.local/bin:/opt/vllm/.venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# uv (skip if already installed)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /opt/vllm

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
RUN if [ -n "${HTTP_PROXY}" ]; then \
      export HTTP_PROXY="${HTTP_PROXY}" HTTPS_PROXY="${HTTPS_PROXY}" \
             http_proxy="${HTTP_PROXY}" https_proxy="${HTTPS_PROXY}"; \
    fi \
    && git clone https://github.com/toncao/vllm.git . \
    && git remote add upstream https://github.com/vllm-project/vllm.git \
    && git fetch upstream "${UPSTREAM_COMMIT}" \
    && git checkout minimax-m3-compressed-tensors \
    && git checkout "${PATCH_COMMIT}"

# Python 3.12 env + install with upstream precompiled kernels
RUN uv venv --python 3.12 .venv \
    && env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
       VLLM_USE_PRECOMPILED=1 \
       uv pip install -e . --torch-backend=auto

RUN python3 - <<'PY'
import vllm
import torch

print("vllm:", vllm.__version__)

op = getattr(torch.ops._C, "fused_minimax_m3_qknorm_rope_kv_insert", None)
if op is None:
    raise SystemExit(
        "ERROR: fused_minimax_m3_qknorm_rope_kv_insert missing; "
        "precompiled wheel likely incompatible — use Dockerfile (scheme B) instead"
    )
print("M3 op schema:", op.schema)
print("official README precompiled install: OK")
PY

ENTRYPOINT ["vllm", "serve"]
