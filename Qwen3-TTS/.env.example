# ============ 模型配置 ============
# 自定义音色模型的权重路径或仓库名（默认本地路径或 HF Hub 名称）
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_MODEL_PATH=/media/llm/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice/

# VoiceDesign 模型的权重路径或仓库名（用于 /v1/audio/voice_design）
TTS_VOICE_DESIGN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_VOICE_DESIGN_MODEL_PATH=/media/llm/Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign/

# 设备与精度：CUDA 可用时推荐 bfloat16；CPU 环境请改为 float32
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_ATTN_IMPL=flash_attention_2

# 默认语者与语言（仅对 CustomVoice 端点生效）
TTS_DEFAULT_VOICE=Vivian
TTS_DEFAULT_LANGUAGE=Chinese

# 临时音频输出目录（生成后会立即上传 MinIO 并删除本地文件）
TTS_OUTPUT_DIR=/tmp/qwen3-tts-outputs

# MinIO 上传的前缀目录（桶内路径前缀）
TTS_MINIO_UPLOAD_DIR=qwen3-tts

# ============ MinIO 访问参数 ============
MINIO_IP=120.133.137.142
MINIO_UPLOAD_PORT=9000
MINIO_UPLOAD_URL=http://120.133.137.142:9000
MINIO_ACCESS_KEY=IoeOmDzCZOkM0CiF6IK3
MINIO_SECRET_KEY=c5gKEUpeU1oirwTOmkbLtXKl0fiDCrtlkmEU0fIt
MINIO_BUCKET_NAME=files

# ============ 服务参数 ============
# HTTP 端口；uvicorn 启动时可覆盖
PORT=6006

# 可选：控制可见 GPU（仅当需要限制卡号时设置）
# CUDA_VISIBLE_DEVICES=0
